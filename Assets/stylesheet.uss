:root {
}

/* ── Fullscreen dark background ── */
.screen {
    flex-grow: 1;
    background-color: rgb(18, 16, 12);
    align-items: center;
    justify-content: center;
}

/* ── Panel card ── */
.panel {
    background-color: rgba(30, 27, 20, 0.92);
    border-width: 1px;
    border-color: rgba(85, 75, 50, 0.4);
    border-radius: 6px;
    padding: 32px;
}

/* ── Typography ── */
.title-text {
    font-size: 72px;
    color: rgb(200, 180, 120);
    -unity-text-align: upper-center;
    -unity-font-style: bold;
    letter-spacing: 10px;
    margin-bottom: 8px;
}

.subtitle-text {
    font-size: 13px;
    color: rgba(200, 180, 120, 0.45);
    -unity-text-align: upper-center;
    letter-spacing: 6px;
    margin-bottom: 56px;
}

.heading-text {
    font-size: 30px;
    color: rgb(200, 180, 120);
    -unity-text-align: upper-center;
    -unity-font-style: bold;
    letter-spacing: 4px;
    margin-bottom: 28px;
}

.label-text {
    font-size: 18px;
    color: rgb(210, 200, 170);
    letter-spacing: 2px;
    -unity-font-style: bold;
}

/* ── Buttons ── */
.button {
    height: 56px;
    font-size: 20px;
    width: 280px;
    background-color: rgba(50, 45, 30, 0.8);
    border-width: 1px;
    border-color: rgba(120, 105, 65, 0.4);
    border-radius: 4px;
    color: rgb(210, 200, 170);
    -unity-font-style: bold;
    padding: 12px 24px;
    margin: 5px 0;
    letter-spacing: 3px;
    transition-duration: 0.15s;
}

.button:hover {
    background-color: rgba(70, 62, 40, 0.9);
    border-color: rgba(200, 180, 120, 0.6);
    color: rgb(230, 210, 150);
}

.button:active {
    background-color: rgba(85, 75, 48, 0.95);
    scale: 0.97;
}

.button-small {
    height: 42px;
    font-size: 15px;
    background-color: rgba(50, 45, 30, 0.8);
    border-width: 1px;
    border-color: rgba(120, 105, 65, 0.4);
    border-radius: 3px;
    color: rgb(210, 200, 170);
    -unity-font-style: bold;
    padding: 8px 20px;
    letter-spacing: 2px;
    transition-duration: 0.15s;
}

.button-small:hover {
    background-color: rgba(70, 62, 40, 0.9);
    border-color: rgba(200, 180, 120, 0.6);
    color: rgb(230, 210, 150);
}

.button-small:active {
    scale: 0.97;
}

.button-accent {
    background-color: rgba(120, 105, 65, 0.5);
    border-color: rgba(200, 180, 120, 0.6);
    color: rgb(200, 180, 120);
}

.button-accent:hover {
    background-color: rgba(145, 128, 78, 0.65);
    border-color: rgb(230, 210, 150);
    color: rgb(230, 210, 150);
}

.button-stepper {
    width: 36px;
    height: 36px;
    font-size: 20px;
    background-color: rgba(50, 45, 30, 0.8);
    border-width: 1px;
    border-color: rgba(120, 105, 65, 0.4);
    border-radius: 3px;
    color: rgb(200, 180, 120);
    -unity-font-style: bold;
    padding: 0;
    transition-duration: 0.15s;
}

.button-stepper:hover {
    background-color: rgba(70, 62, 40, 0.9);
    border-color: rgba(200, 180, 120, 0.6);
}

/* ── Divider ── */
.divider {
    height: 1px;
    background-color: rgba(85, 75, 50, 0.35);
    margin-top: 16px;
    margin-bottom: 16px;
}

/* ── Settings text (legacy compat) ── */
.SettingsText {
    font-size: 18px;
    color: rgb(210, 200, 170);
    letter-spacing: 2px;
}

/* ── Toggle styling ── */
#Container > #Background > #Settings > #Private > .unity-toggle__input {
    justify-content: flex-end;
}

.unity-toggle__input > .unity-toggle__checkmark {
    background-color: rgba(50, 45, 30, 0.8);
    border-color: rgba(120, 105, 65, 0.5);
    -unity-background-image-tint-color: rgb(200, 180, 120);
}

/* ── Code entry slots ── */
.code-slot {
    width: 52px;
    height: 66px;
    margin: 0 5px;
    background-color: rgba(40, 36, 25, 0.9);
    border-width: 1px;
    border-color: rgba(120, 105, 65, 0.4);
    border-radius: 4px;
    font-size: 34px;
    color: rgb(230, 210, 150);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    transition-duration: 0.12s;
}

.code-slot-active {
    border-color: rgb(200, 180, 120);
    background-color: rgba(55, 49, 33, 0.95);
}

.code-hint {
    font-size: 11px;
    color: rgba(200, 180, 120, 0.4);
    letter-spacing: 4px;
    margin-bottom: 24px;
}

.code-hidden-field {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    opacity: 0;
    margin: 0;
}

/* ── Input field styling ── */
.unity-text-field__input,
.unity-integer-field__input {
    background-color: rgba(40, 36, 25, 0.9);
    border-width: 1px;
    border-color: rgba(120, 105, 65, 0.4);
    border-radius: 3px;
    color: rgb(200, 180, 120);
    font-size: 28px;
    padding: 10px 16px;
    -unity-text-align: middle-center;
    letter-spacing: 8px;
}

.unity-text-field__input:focus,
.unity-integer-field__input:focus {
    border-color: rgb(200, 180, 120);
}

/* ── ScrollView ── */
.unity-scroll-view {
    background-color: rgba(15, 13, 10, 0.4);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(85, 75, 50, 0.25);
}

.unity-scroller--vertical > .unity-slider > .unity-base-slider__tracker {
    background-color: rgba(50, 45, 30, 0.4);
}

.unity-scroller--vertical > .unity-slider > .unity-base-slider__dragger {
    background-color: rgba(200, 180, 120, 0.35);
    border-radius: 3px;
}

/* ── Reticle ──
   A fixed dot, plus four ticks that converge on it when something is in
   reach. Ticks sit at their resting offsets here and move inward under
   .crosshair-active, so the transition plays in both directions. */
.reticle {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 40px;
    height: 40px;
    margin-left: -20px;
    margin-top: -20px;
    align-items: center;
    justify-content: center;
}

.reticle-dot {
    width: 6px;
    height: 6px;
    border-radius: 3px;
    background-color: rgba(245, 243, 235, 0.9);
    /* Dark rim; a plain light dot vanishes against the yellow walls. */
    border-width: 1px;
    border-color: rgba(12, 10, 7, 0.65);
    transition-duration: 0.12s;
}

.reticle-tick {
    position: absolute;
    background-color: rgb(240, 224, 170);
    opacity: 0;
    transition-duration: 0.13s;
}

.reticle-tick-t {
    width: 2px;
    height: 7px;
    top: 1px;
}

.reticle-tick-b {
    width: 2px;
    height: 7px;
    bottom: 1px;
}

.reticle-tick-l {
    width: 7px;
    height: 2px;
    left: 1px;
}

.reticle-tick-r {
    width: 7px;
    height: 2px;
    right: 1px;
}

.crosshair-active > .reticle-dot {
    background-color: rgb(240, 224, 170);
    border-color: rgba(12, 10, 7, 0.8);
}

.crosshair-active > .reticle-tick {
    opacity: 1;
}

.crosshair-active > .reticle-tick-t {
    top: 6px;
}

.crosshair-active > .reticle-tick-b {
    bottom: 6px;
}

.crosshair-active > .reticle-tick-l {
    left: 6px;
}

.crosshair-active > .reticle-tick-r {
    right: 6px;
}

/* ── Pickup prompt ── */
.interact-prompt {
    position: absolute;
    top: 50%;
    margin-top: 32px;
    flex-direction: row;
    align-items: center;
    padding: 7px 16px 7px 11px;
    background-color: rgba(10, 9, 6, 0.6);
    border-left-width: 2px;
    border-left-color: rgb(214, 190, 124);
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
}

/* Deeper bottom border reads as a physical key cap. */
.interact-key {
    width: 26px;
    height: 26px;
    align-items: center;
    justify-content: center;
    background-color: rgba(24, 21, 15, 0.95);
    border-width: 1px;
    border-color: rgba(198, 178, 120, 0.5);
    border-bottom-width: 3px;
    border-bottom-color: rgba(198, 178, 120, 0.8);
    border-radius: 4px;
    margin-right: 12px;
}

.interact-key-glyph {
    font-size: 13px;
    color: rgb(238, 222, 168);
    -unity-font-style: bold;
    margin: 0;
}

.interact-text {
    justify-content: center;
}

.interact-verb {
    font-size: 9px;
    color: rgba(206, 190, 150, 0.5);
    letter-spacing: 4px;
    margin: 0;
}

.interact-item {
    font-size: 15px;
    color: rgb(240, 226, 178);
    letter-spacing: 3px;
    -unity-font-style: bold;
    margin: 0;
}

.stamina-bar {
    position: absolute;
    bottom: 116px;
    left: 50%;
    margin-left: -140px;
    width: 280px;
    height: 6px;
    background-color: rgba(15, 13, 10, 0.75);
    border-width: 1px;
    border-color: rgba(120, 105, 65, 0.5);
    border-radius: 3px;
    transition-property: opacity;
    transition-duration: 0.4s;
}

.stamina-fill {
    height: 100%;
    width: 100%;
    background-color: rgb(200, 180, 120);
    border-radius: 2px;
}

/* ── Camcorder overlay ── */
.cam-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.cam-corner {
    position: absolute;
    width: 46px;
    height: 46px;
    border-color: rgba(225, 225, 225, 0.65);
}

.cam-corner-tl {
    top: 36px;
    left: 48px;
    border-top-width: 2px;
    border-left-width: 2px;
}

.cam-corner-tr {
    top: 36px;
    right: 48px;
    border-top-width: 2px;
    border-right-width: 2px;
}

.cam-corner-bl {
    bottom: 36px;
    left: 48px;
    border-bottom-width: 2px;
    border-left-width: 2px;
}

.cam-corner-br {
    bottom: 36px;
    right: 48px;
    border-bottom-width: 2px;
    border-right-width: 2px;
}

.cam-rec-row {
    position: absolute;
    top: 46px;
    left: 70px;
    flex-direction: row;
    align-items: center;
}

.cam-rec-dot {
    width: 14px;
    height: 14px;
    border-radius: 7px;
    background-color: rgb(225, 45, 35);
    margin-right: 9px;
}

.cam-rec-text {
    font-size: 20px;
    color: rgb(235, 235, 235);
    letter-spacing: 4px;
    -unity-font-style: bold;
}

.cam-time {
    position: absolute;
    top: 48px;
    right: 70px;
    font-size: 18px;
    color: rgb(235, 235, 235);
    letter-spacing: 3px;
    -unity-font-style: bold;
}

.cam-bottom-row {
    position: absolute;
    bottom: 46px;
    right: 70px;
    flex-direction: row;
    align-items: center;
}

.cam-meta-text {
    font-size: 13px;
    color: rgba(235, 235, 235, 0.7);
    letter-spacing: 2px;
    margin-right: 14px;
}

.cam-battery {
    flex-direction: row;
    align-items: center;
    height: 16px;
    border-width: 1px;
    border-color: rgba(235, 235, 235, 0.7);
    border-radius: 2px;
    padding: 2px 3px;
}

.cam-battery-bar {
    width: 6px;
    height: 8px;
    background-color: rgba(235, 235, 235, 0.85);
    margin-right: 2px;
}

.cam-battery-bar-dim {
    background-color: rgba(235, 235, 235, 0.2);
    margin-right: 0;
}

/* ── Inventory overlay ── */
.inventory-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(6, 5, 4, 0.82);
    align-items: center;
    justify-content: center;
}

.inventory-panel {
    width: 444px;
    background-color: rgba(24, 22, 16, 0.97);
    border-color: rgba(120, 107, 70, 0.45);
    border-radius: 3px;
    padding: 20px 24px 16px 24px;
}

.inventory-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 16px;
}

.inventory-bullet {
    width: 6px;
    height: 6px;
    background-color: rgb(214, 190, 124);
    rotate: 45deg;
    margin-right: 12px;
}

.inventory-title {
    font-size: 17px;
    color: rgb(226, 208, 152);
    letter-spacing: 7px;
    -unity-font-style: bold;
    margin: 0;
}

/* Fills the space between the title and the capacity readout. */
.inventory-rule {
    flex-grow: 1;
    height: 1px;
    background-color: rgba(140, 125, 82, 0.35);
    margin: 0 16px;
}

.inventory-capacity {
    align-items: flex-end;
}

.inventory-count {
    font-size: 11px;
    color: rgba(206, 190, 150, 0.55);
    letter-spacing: 3px;
    margin: 0;
}

/* Negative margin cancels the leading tick's own margin. */
.capacity-meter {
    flex-direction: row;
    margin-top: 6px;
    margin-left: -3px;
}

.capacity-tick {
    width: 10px;
    height: 3px;
    background-color: rgba(196, 176, 118, 0.16);
    margin-left: 3px;
    transition-duration: 0.15s;
}

.capacity-tick-on {
    background-color: rgb(214, 190, 124);
}

.inventory-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
}

/* ── Slots ── */
.inv-slot {
    width: 88px;
    height: 88px;
    margin: 5px;
    background-color: rgba(33, 30, 21, 0.9);
    border-width: 1px;
    border-color: rgba(88, 79, 52, 0.55);
    border-radius: 3px;
    transition-duration: 0.12s;
}

.inv-slot-filled {
    background-color: rgba(46, 41, 27, 0.92);
    border-color: rgba(196, 176, 118, 0.45);
}

/* Slot under the cursor — the one the 1-4 keys act on. */
.inv-slot-hover {
    background-color: rgba(60, 54, 35, 0.95);
    border-color: rgba(232, 214, 158, 0.9);
}

.inv-slot-dragging {
    opacity: 0.25;
}

.inv-slot-drop-target {
    background-color: rgba(86, 76, 46, 0.95);
    border-color: rgb(240, 226, 178);
    scale: 1.04;
}

/* Inset well the item glyph sits in. */
.slot-frame {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    margin: 6px 6px 2px 6px;
    background-color: rgba(10, 9, 6, 0.5);
    border-width: 1px;
    border-color: rgba(140, 125, 82, 0.14);
    border-radius: 2px;
}

/* Stand-in for real item art: the black crate as it looks in the world,
   lit along its top edge. */
.slot-icon {
    width: 34px;
    height: 34px;
    background-color: rgb(14, 13, 11);
    border-width: 1px;
    border-color: rgba(168, 150, 100, 0.35);
    border-top-color: rgba(232, 214, 158, 0.7);
    border-radius: 2px;
}

.slot-empty-mark {
    width: 10px;
    height: 10px;
    border-width: 1px;
    border-color: rgba(196, 176, 118, 0.12);
}

.slot-name {
    font-size: 9px;
    color: rgba(226, 208, 152, 0.75);
    letter-spacing: 2px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin: 0 0 5px 0;
}

/* Corner tab, so the index never crowds the glyph. */
.slot-index {
    position: absolute;
    top: 0;
    left: 0;
    font-size: 9px;
    color: rgba(196, 176, 118, 0.35);
    -unity-font-style: bold;
    background-color: rgba(10, 9, 6, 0.55);
    padding: 1px 4px 2px 4px;
    border-bottom-right-radius: 3px;
    margin: 0;
}

.inv-slot-filled > .slot-index {
    color: rgba(232, 214, 158, 0.7);
}

.inventory-footer {
    flex-direction: row;
    justify-content: center;
    margin-top: 16px;
    padding-top: 13px;
    border-top-width: 1px;
    border-top-color: rgba(140, 125, 82, 0.22);
}

.hint {
    flex-direction: row;
    align-items: center;
    margin: 0 11px;
}

.hint-key {
    font-size: 9px;
    color: rgba(226, 208, 152, 0.85);
    -unity-font-style: bold;
    letter-spacing: 1px;
    background-color: rgba(10, 9, 6, 0.7);
    border-width: 1px;
    border-color: rgba(140, 125, 82, 0.4);
    border-radius: 2px;
    padding: 2px 5px 3px 5px;
    margin: 0 7px 0 0;
}

.hint-text {
    font-size: 9px;
    color: rgba(206, 190, 150, 0.4);
    letter-spacing: 3px;
    margin: 0;
}

/* ── Hotbar ── */
/* Sits after the inventory overlay in the tree so it stays visible, and
   drag-targetable, while the backpack is open. Horizontal centring comes
   from the HUD root's align-items. */
.hotbar {
    position: absolute;
    bottom: 26px;
    flex-direction: row;
    padding: 6px;
    background-color: rgba(10, 9, 6, 0.5);
    border-width: 1px;
    border-color: rgba(88, 79, 52, 0.35);
    border-radius: 4px;
}

.hotbar-slot {
    width: 66px;
    height: 66px;
    margin: 0 3px;
}

.hotbar-slot > .slot-frame {
    margin: 5px 5px 1px 5px;
}

.hotbar-slot > .slot-frame > .slot-icon {
    width: 26px;
    height: 26px;
}

.hotbar-slot > .slot-name {
    font-size: 8px;
    letter-spacing: 1px;
    margin-bottom: 4px;
}

/* Tilted, so a dragged item reads as lifted off the grid. */
.drag-ghost {
    position: absolute;
    width: 72px;
    height: 72px;
    align-items: center;
    justify-content: center;
    background-color: rgba(56, 50, 32, 0.96);
    border-width: 1px;
    border-color: rgb(240, 226, 178);
    border-radius: 3px;
    rotate: -4deg;
}

.drag-ghost > .slot-name {
    margin: 6px 0 0 0;
}

/* ── Pause menu ── */
.pause-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(8, 7, 5, 0.78);
    align-items: center;
    justify-content: center;
}

.pause-columns {
    flex-direction: row;
    align-items: flex-start;
}

.pause-panel {
    width: 320px;
    padding: 28px;
    margin: 0 10px;
}

.pause-panel > .button {
    width: auto;
    align-self: stretch;
}

.pause-title {
    font-size: 26px;
    color: rgb(200, 180, 120);
    letter-spacing: 8px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 20px;
}

.option-label {
    font-size: 12px;
    color: rgba(200, 180, 120, 0.55);
    letter-spacing: 3px;
    margin-top: 10px;
    margin-bottom: 2px;
}

.pause-panel .unity-base-slider__tracker {
    height: 4px;
    border-radius: 2px;
    background-color: rgba(50, 45, 30, 0.9);
    border-color: rgba(120, 105, 65, 0.4);
}

.pause-panel .unity-base-slider__dragger {
    width: 14px;
    height: 14px;
    border-radius: 7px;
    border-width: 0;
    background-color: rgb(200, 180, 120);
}

.players-panel {
    width: 260px;
    padding: 24px;
    margin: 0 10px;
}

.players-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 12px;
}

.players-title {
    font-size: 16px;
    color: rgb(200, 180, 120);
    letter-spacing: 4px;
    -unity-font-style: bold;
}

.players-count {
    font-size: 14px;
    color: rgba(200, 180, 120, 0.5);
    letter-spacing: 2px;
}

.player-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    background-color: rgba(40, 36, 25, 0.85);
    border-width: 1px;
    border-color: rgba(85, 75, 50, 0.5);
    border-radius: 3px;
    padding: 8px 10px;
    margin-bottom: 4px;
}

.player-name {
    font-size: 13px;
    color: rgb(210, 200, 170);
    letter-spacing: 2px;
}

.player-you {
    font-size: 10px;
    color: rgba(200, 180, 120, 0.6);
    letter-spacing: 2px;
}
